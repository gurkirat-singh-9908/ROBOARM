<?xml version="1.0" ?>
<robot name="roboticarm" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find roboticarm_description)/urdf/materials.xacro" />
<xacro:include filename="$(find roboticarm_description)/urdf/roboticarm.trans" />
<xacro:include filename="$(find roboticarm_description)/urdf/roboticarm.gazebo" />

<link name="base_link">
  <inertial>
    <origin xyz="-0.007118748865126541 0.03854857506884498 0.3409955293067082" rpy="0 0 0"/>
    <mass value="555.7346839951744"/>
    <inertia ixx="27.91875" iyy="27.919694" izz="8.711451" ixy="-0.0" iyz="0.0" ixz="0.008321"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roboticarm_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find roboticarm_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="waist_1">
  <inertial>
    <origin xyz="0.0009107621972253219 -4.249311544579637e-07 0.015904214280618723" rpy="0 0 0"/>
    <mass value="2.53765521355259"/>
    <inertia ixx="0.006015" iyy="0.006217" izz="0.010077" ixy="-0.0" iyz="-0.0" ixz="-5e-05"/>
  </inertial>
  <visual>
    <origin xyz="0.049279 -0.038549 -0.72545" rpy="0 0 0"/>
