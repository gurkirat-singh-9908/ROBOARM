#!/usr/bin/env python3
"""
Publish a single target pose to /target_pose then exit.

Usage (via ros2 run):
  ros2 run roboticarm_moveit2 pose_publisher --ros-args \
       -p x:=0.20 -p y:=0.05 -p z:=0.25 \
       -p qx:=0.0 -p qy:=0.0 -p qz:=0.0 -p qw:=1.0

Defaults publish to x=0.20, y=0.0, z=0.30 with identity orientation.
The frame_id defaults to 'base_link'.
"""
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import PoseStamped


class PosePublisher(Node):
    def __init__(self):
        super().__init__('pose_publisher')

        self.declare_parameter('x',   0.20)
        self.declare_parameter('y',   0.00)
        self.declare_parameter('z',   0.30)
        self.declare_parameter('qx',  0.00)
        self.declare_parameter('qy',  0.00)
        self.declare_parameter('qz',  0.00)
        self.declare_parameter('qw',  1.00)
        self.declare_parameter('frame_id', 'base_link')

        self.pub_ = self.create_publisher(PoseStamped, '/target_pose', 1)

        # Wait one second so ik_mover subscriber has time to connect
        self.timer_ = self.create_timer(1.0, self._publish_once)

    def _publish_once(self):
        self.timer_.cancel()

        msg = PoseStamped()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = self.get_parameter('frame_id').value

        msg.pose.position.x = self.get_parameter('x').value
        msg.pose.position.y = self.get_parameter('y').value
        msg.pose.position.z = self.get_parameter('z').value
        msg.pose.orientation.x = self.get_parameter('qx').value
        msg.pose.orientation.y = self.get_parameter('qy').value
        msg.pose.orientation.z = self.get_parameter('qz').value
        msg.pose.orientation.w = self.get_parameter('qw').value

        self.pub_.publish(msg)
        self.get_logger().info(
            'Published target pose — '
            f'position: ({msg.pose.position.x:.3f}, {msg.pose.position.y:.3f}, {msg.pose.position.z:.3f})  '
            f'orientation: ({msg.pose.orientation.x:.3f}, {msg.pose.orientation.y:.3f}, '
            f'{msg.pose.orientation.z:.3f}, {msg.pose.orientation.w:.3f})'
        )

        raise SystemExit  # clean shutdown after single publish


def main():
    rclpy.init()
    node = PosePublisher()
    try:
        rclpy.spin(node)
    except SystemExit:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
